# Checkpoint 7 — the CSV contract.
#
# Three translations at one angle, all appending to ONE file, with an explicit
# projection id and reseed per measurement — exactly the pattern
# full_scan_template.mac generates. Run from build/.
#
# EXPECT afterwards:
#     cat ../data/raw/checkpoint7.csv
#   -> one header line + THREE rows, ids 0,1,2, translations 0/20/40 mm,
#      n_events 50000 each, and n_counts falling as the ray moves off the
#      pipe axis onto a longer chord through the wall.
#
# Delete the file before re-running, or you will append a second set of rows —
# which is the intended behaviour, not a bug.

/run/verbose      0
/event/verbose    0
/tracking/verbose 0

/cttwin/phantom pipe
/run/initialize

/cttwin/output/file ../data/raw/checkpoint7.csv
/cttwin/scan/angle 0 deg

/random/setSeeds 101 202
/cttwin/output/projectionId 0
/cttwin/scan/translation 0 mm
/run/beamOn 50000

/random/setSeeds 303 404
/cttwin/output/projectionId 1
/cttwin/scan/translation 20 mm
/run/beamOn 50000

/random/setSeeds 505 606
/cttwin/output/projectionId 2
/cttwin/scan/translation 40 mm
/run/beamOn 50000
